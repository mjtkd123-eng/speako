# SQLite path is fixed in prisma/schema.prisma (file:./dev.db).
# Keep this only if you later switch to Postgres.
# DATABASE_URL="file:./prisma/dev.db"

AUTH_SECRET="replace-with-a-32-char-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth (buttons still render without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_ID=""
APPLE_SECRET=""

# PortOne V2. Empty values enable local demo checkout.
NEXT_PUBLIC_PORTONE_STORE_ID=""
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=""
PORTONE_API_SECRET=""
PORTONE_WEBHOOK_SECRET=""

# Combined platform + PG fee is 3.3% of gross.
PLATFORM_ENTITY_NAME="Speako Learning Pte. Ltd."
PLATFORM_ENTITY_ADDRESS="1 Raffles Place, Singapore"
